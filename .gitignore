# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# Build output and tool caches
dist/
coverage/
.vite/
.cache/
.playwright-mcp/
art/drafts/
# Godot source stays tracked; only its cache and export output are ignored.
/game/.godot/
/game/build/
*.tsbuildinfo
.eslintcache
.stylelintcache
vite.config.*.timestamp-*

# Logs and diagnostic reports
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*-firebase-adminsdk-*.json
service-account*.json

# Personal data backups
focuswilds-backup*.json

# OS files
.DS_Store
Thumbs.db
Desktop.ini
