rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId
        && userId == '7FnLLAGqAFYO269Jl1j2I8lEQbx2';
    }
    function totals(data) {
      return data.sessions is int && data.sessions >= 0
        && data.seconds is int && data.seconds >= data.sessions * 60
        && data.seconds <= data.sessions * 10800;
    }
    function validProfile(data) {
      return data.keys().size() == 9
        && data.keys().hasOnly(['version', 'revision', 'ready', 'sessions', 'seconds', 'encounters', 'latest', 'selected', 'migration'])
        && data.version == 1 && data.revision is int && data.revision >= 0
        && data.ready is bool && totals(data)
        && data.encounters is list && data.encounters.size() == 3
        && data.encounters[0] is int && data.encounters[0] >= 0
        && data.encounters[1] is int && data.encounters[1] >= 0
        && data.encounters[2] is int && data.encounters[2] >= 0
        && data.encounters[0] + data.encounters[1] + data.encounters[2] == data.sessions
        && (data.selected == 'moss'
          || (data.selected == 'rabbit' && data.encounters[0] > 0)
          || (data.selected == 'bird' && data.encounters[1] > 0)
          || (data.selected == 'squirrel' && data.encounters[2] > 0));
    }
    match /users/{userId}/state/progress {
      allow get: if owner(userId);
      allow create: if owner(userId) && validProfile(request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if owner(userId) && validProfile(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
    }
    match /users/{userId}/days/{day} {
      allow get: if owner(userId);
      allow list: if owner(userId) && request.query.limit <= 30;
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['day', 'sessions', 'seconds'])
        && request.resource.data.day == day && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && totals(request.resource.data);
    }
    match /users/{userId}/sessions/{sessionId} {
      allow get: if owner(userId);
      allow list: if owner(userId) && request.query.limit <= 25;
      allow create: if owner(userId)
        && request.resource.data.keys().hasOnly(['id', 'title', 'startedAt', 'completedAt', 'seconds'])
        && request.resource.data.id == sessionId
        && sessionId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.startedAt is string && request.resource.data.completedAt is string
        && request.resource.data.seconds is int && request.resource.data.seconds >= 60 && request.resource.data.seconds <= 10800;
    }
  }
}
