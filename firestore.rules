rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == '7FnLLAGqAFYO269Jl1j2I8lEQbx2'
        && uid == request.auth.uid;
    }
    function validEvent(event) {
      return event is map
        && event.keys().hasAll(['id', 'type', 'occurredAt', 'version', 'mode', 'environment', 'code'])
        && event.keys().hasOnly(['id', 'type', 'occurredAt', 'version', 'mode', 'environment', 'code', 'limited'])
        && event.id is string && event.id.matches('[0-9a-f-]{36}')
        && event.type in ['sign_in', 'sign_out_requested', 'account_error']
        && event.occurredAt is timestamp
        && event.version is string && event.version.size() <= 32
        && event.mode in ['pwa', 'browser']
        && event.environment in ['local', 'deployed']
        && (!('limited' in event) || (event.limited is map
          && event.limited.keys().hasAll(['windowStartedAt', 'count'])
          && event.limited.keys().hasOnly(['windowStartedAt', 'count'])
          && event.limited.windowStartedAt is timestamp
          && event.limited.count is int && event.limited.count >= 1 && event.limited.count <= 1000000))
        && ((event.type != 'account_error' && event.code == 'none')
          || (event.type == 'account_error' && event.code in ['auth/invalid-redirect', 'auth/access-denied', 'auth/sign-in-cancelled', 'auth/network-request-failed', 'auth/too-many-requests', 'auth/restore-failed', 'auth/unknown']));
    }
    function validHistory() {
      let data = request.resource.data;
      return data.keys().hasAll(['events', 'updatedAt', 'windowStartedAt', 'windowCount'])
        && data.keys().hasOnly(['events', 'updatedAt', 'windowStartedAt', 'windowCount'])
        && data.updatedAt == request.time
        && data.windowStartedAt is timestamp
        && data.windowCount is int && data.windowCount >= 1 && data.windowCount <= 60
        && data.events is list && data.events.size() >= 1 && data.events.size() <= 100
        && validEvent(data.events[data.events.size() - 1]);
    }
    function newWindow() {
      return request.resource.data.windowStartedAt == request.time
        && request.resource.data.windowCount == 1;
    }
    function validRateUpdate() {
      let previous = resource.data;
      let next = request.resource.data;
      // Existing history without rate metadata upgrades once, retaining its events.
      return !previous.keys().hasAny(['windowStartedAt', 'windowCount'])
        ? newWindow()
        : (request.time >= previous.windowStartedAt + duration.value(60, 's')
          ? newWindow()
          : next.windowStartedAt == previous.windowStartedAt
            && next.windowCount == previous.windowCount + 1);
    }
    function validFocusRound(roundId) {
      let data = request.resource.data;
      return roundId.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && data.keys().hasAll(['schemaVersion', 'roundId', 'task', 'mode', 'plannedMinutes', 'elapsedMs', 'completion', 'savedAt'])
        && data.keys().hasOnly(['schemaVersion', 'roundId', 'task', 'mode', 'plannedMinutes', 'elapsedMs', 'completion', 'savedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.roundId == roundId
        && data.task is string && data.task.size() <= 10000
        && data.mode in ['down', 'up']
        && data.plannedMinutes is int && data.plannedMinutes >= 1 && data.plannedMinutes <= 180
        && data.elapsedMs is int && data.elapsedMs >= 0 && data.elapsedMs <= 9007199254740991
        && (data.mode == 'up' || data.elapsedMs <= data.plannedMinutes * 60000)
        && data.completion == (data.mode == 'down' && data.elapsedMs == data.plannedMinutes * 60000 ? 'completed' : 'ended')
        && data.savedAt == request.time;
    }
    function validFocusCounter(uid) {
      let data = request.resource.data;
      let roundPath = /databases/$(database)/documents/users/$(uid)/focusRounds/$(data.lastRoundId);
      return data.keys().hasAll(['count', 'windowStartedAt', 'windowCount', 'updatedAt', 'lastRoundId'])
        && data.keys().hasOnly(['count', 'windowStartedAt', 'windowCount', 'updatedAt', 'lastRoundId'])
        && data.count is int && data.count >= 1 && data.count <= 10000
        && data.windowCount is int && data.windowCount >= 1 && data.windowCount <= 60
        && data.windowStartedAt is timestamp && data.updatedAt == request.time
        && data.lastRoundId is string
        && data.lastRoundId.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && !exists(roundPath) && getAfter(roundPath).data.savedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['schemaVersion', 'language', 'timezone', 'createdAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'language', 'timezone', 'createdAt'])
        && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
        && request.resource.data.language == 'en'
        && request.resource.data.timezone == 'Asia/Bangkok'
        && request.resource.data.createdAt == request.time;
      match /focus/{documentId} {
        allow get: if owner(uid) && documentId == 'history';
        allow create: if owner(uid) && documentId == 'history' && validFocusCounter(uid)
          && request.resource.data.count == 1 && newWindow();
        allow update: if owner(uid) && documentId == 'history' && validFocusCounter(uid)
          && request.resource.data.count == resource.data.count + 1
          && (request.time >= resource.data.windowStartedAt + duration.value(60, 's')
            ? newWindow()
            : request.resource.data.windowStartedAt == resource.data.windowStartedAt
              && request.resource.data.windowCount == resource.data.windowCount + 1);
      }
      match /focusRounds/{roundId} {
        allow get: if owner(uid);
        allow create: if owner(uid) && validFocusRound(roundId)
          && getAfter(/databases/$(database)/documents/users/$(uid)/focus/history).data.lastRoundId == roundId
          && getAfter(/databases/$(database)/documents/users/$(uid)/focus/history).data.updatedAt == request.time;
      }
      match /logs/{logId} {
        allow get: if owner(uid) && logId == 'account';
        allow create: if owner(uid) && logId == 'account' && validHistory() && newWindow()
          && request.resource.data.events.size() == 1;
        allow update: if owner(uid) && logId == 'account' && validHistory() && validRateUpdate()
          && request.resource.data.events == (resource.data.events.size() < 100
            ? resource.data.events
            : resource.data.events.removeAll([resource.data.events[0]]))
              .concat([request.resource.data.events[request.resource.data.events.size() - 1]]);
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
