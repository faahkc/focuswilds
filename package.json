{
    "name": "focuswilds",
    "private": true,
    "version": "0.1.17",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint",
        "preview": "vite preview",
        "test": "node --test tests/*.test.mjs",
        "emulators": "firebase emulators:start --project demo-focuswilds --only auth,firestore",
        "test:emulators": "firebase emulators:exec --project demo-focuswilds --only auth,firestore \"node tests/firebase.emulator.mjs\"",
        "app:version": "node scripts/version.mjs",
        "version:minor": "node scripts/version.mjs minor",
        "version:major": "node scripts/version.mjs major",
        "prepare": "node scripts/install-hooks.mjs"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@supabase/supabase-js": "^2.117.3",
        "@tailwindcss/vite": "^4.3.3",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "lucide-react": "^1.57.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "firebase-tools": "^15.34.0",
        "oxlint": "^1.81.0",
        "typescript": "~6.0.2",
        "vite": "^8.3.0"
    }
}
